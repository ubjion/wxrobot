# 复制为本地环境配置后填写，不要提交真实 Key
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
FIRECRAWL_API_KEY=
WX_BOT_SEND_MODE=auto
WX_BOT_USER_REFRESH_INTERVAL=30
WX_BOT_FALLBACK_REPLY=我收到啦，但 AI 服务暂时不可用，请稍后再试。
WX_BOT_CONTEXT_MESSAGES=20
WX_BOT_KNOWLEDGE_DIR=C:\path\to\knowledge
# WX_BOT_KNOWLEDGE_DB=C:\path\to\knowledge.sqlite
WX_BOT_SUMMARY_MESSAGES=50
